# 环境配置
PORT=22648
NODE_ENV=development

# LLM Provider: deepseek | stepfun
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# StepFun（阶跃星辰）
STEPFUN_API_KEY=your_stepfun_api_key
STEPFUN_BASE_URL=https://api.stepfun.com
STEPFUN_FLASH_MODEL=step-3.7-flash
STEPFUN_PRO_MODEL=step-3.7-flash

# 豆包（火山方舟）
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_FLASH_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_PRO_MODEL=doubao-seed-2-0-lite-260428

# 行情数据
STOCK_API=tencent

# 数据库
DB_PATH=./data/invest-agent.db

# 微信桥接状态目录
# 默认保存在本项目 .state，避免和全局 Claude Code 微信桥接共用 ~/.openclaw。
INVEST_AGENT_WEIXIN_STATE_DIR=./.state

# ACP
ACP_AGENT_ID=invest-agent
ACP_AGENT_NAME=投资选股助手

# Codex ACP
# Invest Agent no longer runs its own Agent Runtime by default.
# Invest Agent starts/stops codex-acp as a child process.
CODEX_ACP_COMMAND=/Users/combo/.local/bin/codex-acp
CODEX_ACP_ARGS=
CODEX_ACP_CWD=/Users/combo/MyFile/projects/invest-agent
CODEX_ACP_TIMEOUT_MS=1800000

# 旁路微信通道
# 默认关闭。开启后通过 /admin/bypass-weixin 后台绑定独立微信桥,与主链路隔离,用于对比测试或主桥挂时应急。
BYPASS_WEIXIN_AUTO_START=false
HERMES_ACP_TIMEOUT_MS=1800000
