# 环境配置
PORT=22655
# 生产服务器建议设为 127.0.0.1, 再通过 SSH tunnel 或 Nginx 白名单访问 Platform。
# 默认仅监听 127.0.0.1。除非前方有完成认证的反向代理，不要监听公网地址。
# HOST=127.0.0.1
NODE_ENV=development
# 除 /health 和 sandbox HMAC API 外，所有本地 HTTP 服务面必须携带此令牌。
# 生产环境必须显式设置；开发环境若未设置会生成 data/.service-api-token。
INVEST_AGENT_API_TOKEN=replace_with_a_long_random_secret

# Platform 后台账号（本地首次启动可自动生成密码文件；生产环境必须显式设置）
# PLATFORM_BOOTSTRAP_USERNAME=owner
# PLATFORM_BOOTSTRAP_PASSWORD=replace_with_a_long_random_password
# PLATFORM_BOOTSTRAP_PASSWORD_FILE=./data/.platform-bootstrap-password
# PLATFORM_ANONYMIZATION_SECRET=replace_with_a_long_random_secret
# PLATFORM_ANONYMIZATION_PREVIOUS_SECRET=optional_previous_secret_during_rotation

# LLM Provider: deepseek | stepfun
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# StepFun（阶跃星辰）
STEPFUN_API_KEY=your_stepfun_api_key
STEPFUN_BASE_URL=https://api.stepfun.com
STEPFUN_FLASH_MODEL=step-3.7-flash
STEPFUN_PRO_MODEL=step-3.7-flash

# 豆包（火山方舟）
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_FLASH_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_PRO_MODEL=doubao-seed-2-0-lite-260428

# 行情数据
STOCK_API=tencent

# 数据库
DB_PATH=./data/invest-agent.db
RUNTIME_DATA_ROOT=./data
# 服务器生产环境必须显式设置 workspace 根目录,避免使用本机默认路径。
# WORKSPACE_ROOT=/home/claude/invest-agent-data/workspaces
WORKSPACE_TEMPLATE_PATH=./templates/workspace

# 微信桥接状态目录
# 默认保存在本项目 .state，避免和全局 Claude Code 微信桥接共用 ~/.openclaw。
INVEST_AGENT_WEIXIN_STATE_DIR=./.state

# ACP
ACP_AGENT_ID=invest-agent
ACP_AGENT_NAME=投资选股助手
ACP_BACKEND=codex

# ACP backends
# Invest Agent no longer runs its own Agent Runtime by default.
# It starts the selected ACP backend as a child process.
# Code default is Codex ACP; backend selection is explicit runtime configuration, not a Platform UI switch.
CODEX_ACP_COMMAND=/Users/combo/.local/bin/codex-acp
CODEX_ACP_ARGS=
CODEX_ACP_CWD=/Users/combo/MyFile/projects/invest-agent-ideal
CODEX_ACP_TIMEOUT_MS=1800000
CODEX_SOURCE_HOME=/Users/combo/.codex
CODEX_SIMPLE_MODEL=gpt-5.6-luna
CODEX_COMPLEX_MODEL=gpt-5.6-terra
ACP_MODEL_ROUTER_ENABLED=true
ACP_SIMPLE_MODEL_ENABLED=false
ACP_MODEL_ROUTER_TIMEOUT_MS=3000
# Hermes Agent (Nous Research) ACP backend — 仅兼容/实验用途，需要显式修改运行时配置
HERMES_ACP_COMMAND=/Users/combo/.local/bin/hermes
HERMES_ACP_ARGS=acp --accept-hooks
HERMES_ACP_TIMEOUT_MS=1800000
# 全局 ~/.hermes 源目录,首次启动时 copy config.yaml/auth.json/.env 到每个 workspace 的 .hermes/
HERMES_SOURCE_HOME=/Users/combo/.hermes

# 用户门户 local connector
# 本地 SQLite conversation_sessions / conversation_messages 是权威对话日志;云端门户只做镜像与 Relay。
PORTAL_PUBLIC_URL=http://localhost:3100
PORTAL_CONNECTOR_AUTO_START=true
PORTAL_RELAY_URL=ws://localhost:3199
PORTAL_CONNECTOR_TOKEN=dev-connector-token
PORTAL_CONNECTOR_REFRESH_MS=30000
# 仅允许由运维控制的对象存储域名用于附件 downloadUrl；默认留空并禁用远程下载。
# PORTAL_ATTACHMENT_DOWNLOAD_HOSTS=attachments.example.com
# 用于区分本机开发 connector 与火山云生产 connector,避免 relay 冲突排查困难。
PORTAL_CONNECTOR_ID_PREFIX=local-dev
PORTAL_CONNECTOR_RUNTIME_LABEL=本机开发
# 可选:限制 connector manager 只注册特定助手/用户,逗号分隔;支持 instanceId 或 userId。
# PORTAL_CONNECTOR_INCLUDE_ASSISTANTS=invest-agent-111,invest-agent-dyk
# PORTAL_CONNECTOR_EXCLUDE_ASSISTANTS=invest-agent-111,invest-agent-dyk

# 单助手 connector 调试时才设置以下变量;正常服务自动模式不要设置,否则只会注册指定助手。
# PORTAL_USER_ID=primary
# PORTAL_INSTANCE_ID=invest-agent-primary
# PORTAL_ASSISTANT_ID=invest-agent-primary
# PORTAL_PROJECT_ID=invest-agent
# PORTAL_CONNECTOR_ID=local-invest-agent-primary
# PORTAL_CONNECTOR_DISPLAY_NAME=本地投资助手
# Set to true on a development machine to force Platform provisioning and the
# connector to use the local Portal, ignoring any historic remote Portal URLs.
PORTAL_LOCAL_ONLY=false
