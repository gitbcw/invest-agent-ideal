{
  "name": "invest-agent",
  "version": "1.0.0",
  "private": true,
  "description": "投资选股智能体 - ACP Agent",
  "scripts": {
    "postinstall": "node scripts/patch-weixin-agent-sdk.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test DB_PATH=./data/test.db WORKSPACE_ROOT=./data/test-workspaces RUNTIME_DATA_ROOT=./data/test-runtime tsx scripts/test-db-bootstrap.ts && NODE_ENV=test DB_PATH=./data/test.db WORKSPACE_ROOT=./data/test-workspaces RUNTIME_DATA_ROOT=./data/test-runtime node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:boundary": "node scripts/run-boundary-tests.mjs",
    "typecheck": "tsc --noEmit",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "verify": "npm test && npm run check:agent-context && npm run build && npm run test:boundary",
    "smoke:strategy-expansion": "npm run build && node scripts/strategy-instance-expansion-smoke.mjs",
    "smoke:review-viewpoint": "npm run build && node scripts/review-viewpoint-smoke.mjs",
    "smoke:indicators": "npm run build && node scripts/indicators-smoke.mjs",
    "smoke:script-indicator": "npm run build && node scripts/script-indicator-smoke.mjs",
    "smoke:composite-indicator": "npm run build && node scripts/composite-indicator-smoke.mjs",
    "smoke:indicator-acknowledgement": "npm run build && node scripts/indicator-acknowledgement-smoke.mjs",
    "smoke:main-force-control": "npm run build && node scripts/main-force-control-smoke.mjs",
    "smoke:schedules-loader": "npm run build && node scripts/schedules-loader-smoke.mjs",
    "smoke:onboarding-confirm-step": "npm run build && node scripts/onboarding-confirm-step-smoke.mjs",
    "smoke:onboarding-draft-commit": "npm run build && node scripts/onboarding-draft-commit-smoke.mjs",
    "smoke:stage1-scheduler": "npm run build && node scripts/stage1-scheduled-tasks-smoke.mjs",
    "smoke:stage2-watch-rules": "npm run build && node scripts/watch-rules-stage2-smoke.mjs",
    "smoke:attachment-store": "npm run build && node scripts/attachment-store-smoke.mjs",
    "smoke:portal-conversation-log": "npm run build && node scripts/portal-conversation-log-smoke.mjs",
    "smoke:portal-attachment": "npm run build && node scripts/portal-attachment-smoke.mjs",
    "smoke:security-boundary": "npm run build && node scripts/security-boundary-smoke.mjs",
    "smoke:db-legacy-migration": "npm run build && node scripts/db-legacy-migration-smoke.mjs",
    "smoke:db-legacy-alerts-drop": "npm run build && node scripts/db-legacy-alerts-drop-smoke.mjs",
    "smoke:mcp-service-tools": "npm run build && node scripts/mcp-service-tools-smoke.mjs",
    "smoke:scheduled-review-publication": "npm run build && node scripts/scheduled-review-publication-smoke.mjs",
    "smoke:workspace-compatibility": "npm run build && node scripts/workspace-compatibility-acceptance.mjs",
    "smoke:route-uniqueness": "npm run build && node scripts/route-uniqueness-smoke.mjs",
    "smoke:platform-investment-state": "npm run build && node scripts/platform-investment-state-smoke.mjs",
    "smoke:platform-partner-auth": "npm run build && node scripts/platform-partner-auth-smoke.mjs",
    "smoke:platform-partner-migration": "npm run build && node scripts/platform-partner-migration-smoke.mjs",
    "smoke:offline-runtime": "npm run build && node scripts/offline-runtime-smoke.mjs",
    "smoke:external-market-providers": "npm run build && node scripts/external-market-providers-smoke.mjs",
    "capability:market-data": "npm run build && node scripts/capabilities/market-data.mjs",
    "capability:market-data:test": "node --import tsx --test tests/capabilities/market-data-capability.test.ts tests/capabilities/market-data-runner.test.ts tests/capabilities/market-adapter-boundary.test.ts tests/capabilities/market-internal-boundary.test.ts",
    "capability:market-data:live": "npm run capability:market-data -- --live",
    "capability:research": "npm run build && node scripts/capabilities/research.mjs",
    "capability:research:test": "node --import tsx --test tests/capabilities/research-runner.test.ts tests/external-evidence-search.test.ts",
    "capability:research:live": "npm run capability:research -- --live",
    "capability:indicators": "npm run build && node scripts/capabilities/indicators.mjs",
    "capability:indicators:test": "node --import tsx --test tests/capabilities/indicator-capability.test.ts",
    "probe:market-data-live": "npm run build && node scripts/market-data-live-probe.mjs",
    "eval:acp-data-quality": "npm run build && CODEX_MODEL=gpt-5.6-sol node scripts/acp-data-quality-eval.mjs",
    "eval:acp-data-quality:searxng": "npm run build && CODEX_MODEL=gpt-5.6-sol EXTERNAL_WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8888/search ACP_EVAL_REQUIRED_SEARCH_PROVIDER=searxng_web_search node scripts/acp-data-quality-eval.mjs",
    "searxng:up": "bash scripts/searxng-sidecar.sh up",
    "searxng:down": "bash scripts/searxng-sidecar.sh down",
    "searxng:health": "bash scripts/searxng-sidecar.sh health",
    "searxng:logs": "bash scripts/searxng-sidecar.sh logs",
    "logs": "node scripts/recent-logs.mjs",
    "logs:errors": "node scripts/recent-logs.mjs errors",
    "repair:orphan-conversation-log": "node scripts/repair-orphan-conversation-log.mjs",
    "cache:clear-indicator": "node scripts/clear-indicator-cache.mjs",
    "scan:convergence": "node scripts/convergence-responsibility-scan.mjs",
    "weixin:mobile": "npm run build && node scripts/weixin-mobile.mjs",
    "portal:connector": "tsx src/portal/connector.ts",
    "volcano:package-runtime": "bash scripts/package-volcano-runtime.sh",
    "volcano:apply-runtime": "bash scripts/apply-volcano-runtime.sh",
    "volcano:configure-portal": "bash scripts/configure-volcano-portal-env.sh",
    "backup:workspaces": "bash scripts/backup-volcano-workspaces.sh",
    "backup:workspaces:install": "bash scripts/install-volcano-workspace-backup-launchagent.sh",
    "backup:workspaces:smoke": "bash scripts/volcano-workspace-backup-smoke.sh",
    "release:snapshot": "node scripts/release-snapshot.mjs",
    "release:snapshot:smoke": "node scripts/release-snapshot-smoke.mjs",
    "probe:market-data-tool": "node scripts/mcp-market-data-tool-probe.mjs",
    "probe:mcp-acp-e2e": "npm run build && node scripts/mcp-acp-e2e-probe.mjs",
    "probe:mcp-tool-call": "npm run build && node scripts/mcp-acp-tool-call-probe.mjs",
    "probe:mcp-fixture-tool-call": "npm run build && node scripts/mcp-acp-fixture-tool-call-probe.mjs",
    "release:deploy": "node scripts/release-deploy.mjs deploy",
    "release:rollback": "node scripts/release-deploy.mjs rollback",
    "release:workspace-rollback": "node scripts/workspace-rollback.mjs",
    "workspace:preflight": "npm run build && node scripts/workspace-compatibility.mjs preflight",
    "workspace:migrate": "npm run build && node scripts/workspace-compatibility.mjs apply",
    "workspace:adopt-template": "npm run build && node scripts/workspace-compatibility.mjs adopt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "retention:report": "tsx src/scripts/file-retention-backfill.ts report",
    "retention:backup": "tsx src/scripts/file-retention-backfill.ts backup",
    "retention:backfill": "tsx src/scripts/file-retention-backfill.ts backfill",
    "retention:cleanup": "tsx src/scripts/file-retention-backfill.ts cleanup",
    "retention:trash": "tsx src/scripts/file-retention-backfill.ts trash"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.16.1",
    "@fastify/cors": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "node-html-parser": "^7.1.0",
    "qrcode": "^1.5.4",
    "weixin-agent-sdk": "^0.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "isolated-vm": "^6.1.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
